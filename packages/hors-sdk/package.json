{
  "name": "hors-sdk",
  "version": "0.1.0",
  "description": "HORS (Human-Origin Resource Sharing): gate, adapters, signer and resolvers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqlyj/hors.git",
    "directory": "packages/hors-sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers/index.d.ts",
      "default": "./dist/resolvers/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@worldcoin/agentkit-core": "^0.2.1",
    "viem": "^2.46.2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@worldcoin/agentkit-core": "0.2.1",
    "express": "5.2.1",
    "viem": "2.56.3",
    "zod": "^4.5.4"
  }
}
